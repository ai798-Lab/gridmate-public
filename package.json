{
  "name": "snaptiler-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "build:scene": "esbuild window-scene.js --bundle --format=esm --minify --outfile=window-scene.bundle.js",
    "build:motion": "esbuild scroll-depth.js --bundle --format=esm --minify --outfile=scroll-depth.bundle.js",
    "build": "npm run build:motion && npm run build:scene && node scripts/version-assets.mjs"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lenis": "1.3.26"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
